# .env.example
# Existing variables
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# Fajaede benchmark (percentiles vs similar sites): same key as BENCHMARK_API_KEY on api.fajaede.eu.
# Without it the app shows "Nog geen benchmark" instead of a percentile.
BENCHMARK_API_KEY=replace-with-the-backend-benchmark-key
# Optional, defaults to https://api.fajaede.eu
BENCHMARK_API_URL=
# Server-only app URL used to create absolute Trust Badge embed code.
PSA_APP_URL=https://psa.fajaede.nl
# Optional server-only app URL used for premium payment redirects; defaults to the current app origin.
PREMIUM_APP_URL=
# Mollie keys: test key outside production, live key in production (MOLLIE_API_KEY)
MOLLIE_TEST_KEY=test_replace-me
MOLLIE_API_KEY=live_replace-me
# Owner pages (/admin, /dashboard): HTTP Basic auth, password min. 16 characters
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
# Weekly accounting report (Vercel Cron) and Cloudflare Turnstile on the scan forms
ACCOUNTANT_EMAIL=accountant@example.com
CRON_SECRET=replace-with-a-long-random-string
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Local development only (.env.development.local): database from docker-compose.dev.yml and
# dashboard login links printed in the terminal instead of emailed
# DATABASE_URL=postgresql://psa:psa@localhost:5432/psa_dev
# DEV_LOG_LOGIN_LINKS=1
# PSA_APP_URL=http://localhost:3000
# Pricing (in euros)
PREMIUM_PRICE_RESCAN=149
PREMIUM_PRICE_RESCAN_ADV=249
# Owner email for dashboard
OWNER_EMAIL=owner@example.com
# Email settings (already used elsewhere)
SMTP_FROM=info@fajaede.nl
SMTP_HOST=email.mijndomein.nl
SMTP_PORT=587
SMTP_USER=info@fajaede.nl
SMTP_PASS=********
# Web Bot Auth (signed FajaedeScan requests): the same random 32-byte base64url seed as
# WEB_BOT_AUTH_SCAN_KEY on the api.fajaede.eu server. Without it scans are not signed.
WEB_BOT_AUTH_SCAN_KEY=
