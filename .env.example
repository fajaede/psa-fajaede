# .env.example
# Existing variables
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# Keep the benchmark datastore server-side; api.fajaede.eu is the search API, not this direct stats endpoint.
MEILISEARCH_HOST=https://your-private-meilisearch-host.example
MEILISEARCH_API_KEY=replace-with-server-only-key
MEILISEARCH_INDEX=pages
# The Next.js PSA app host serves /embed/psa; leave empty to use the current host.
NEXT_PUBLIC_PSA_API_BASE_URL=https://psa.fajaede.nl
# Mollie test key (already provided)
MOLLIE_TEST_KEY=test_5dxfedaARztkwUEw3hEheQhFr47Brb
# Pricing (in euros)
PREMIUM_PRICE_RESCAN=149
PREMIUM_PRICE_RESCAN_ADV=249
# Owner email for dashboard
OWNER_EMAIL=fajaede@live.nl
# Email settings (already used elsewhere)
